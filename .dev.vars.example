# Copy to `.dev.vars` for `wrangler dev` (not committed).
# Required secrets for hosted sign-in: use `wrangler secret put` in production.

# CourtListener API access
# COURTLISTENER_API_KEY=

# Hosted auth (Worker-native OIDC)
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# MCP_AUTH_OIDC_CLIENT_ID=
# MCP_AUTH_OIDC_CLIENT_SECRET=
# MCP_UI_SESSION_SECRET=

# Local development: disable Durable Object rate limits when the limiter is unavailable
# (avoids oauth_route_rate_limit_unavailable during partial local setups).
MCP_AUTH_FAILURE_RATE_LIMIT_ENABLED=false

# `pnpm run dev:workers` starts Edge and MCP together with a local MCP_SERVICE binding.

# Keep async queue execution disabled until its production bindings and release
# receipt are explicitly enabled.
MCP_ASYNC_QUEUE_ENABLED=false

# MCP protocol surface (optional; defaults shown in MCP_CURRENT_STATE.md)
# LOGGING_ENABLED=true
# SAMPLING_ENABLED=false
# MCP_RESOURCE_SUBSCRIPTIONS=true
# MCP_NATIVE_TASKS_ENABLED=false
# MCP_LIST_CHANGED_ENABLED=false
# MCP_TEST_SUBSCRIPTION_REFRESH_MS=

# MCP v2 is stateless; no session-topology settings are required.
