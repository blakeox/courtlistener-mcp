{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "typecheck"],
      "group": "build",
      "problemMatcher": "$tsc"
    },
    {
      "label": "Watch TypeScript",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev"],
      "isBackground": true,
      "group": "build",
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "Unit tests",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:unit"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Workers tests",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "test:workers"],
      "group": "test"
    },
    {
      "label": "Cloudflare startup profiles",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "cloudflare:check:startup"],
      "group": "test"
    },
    {
      "label": "Workers topology dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev:workers"],
      "isBackground": true,
      "group": "build",
      "problemMatcher": []
    }
  ]
}
