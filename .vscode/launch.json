{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch local MCP",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "mcp"],
      "preLaunchTask": "Build",
      "env": { "NODE_ENV": "development", "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug current test file",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "--inspect-brk", "--test", "${file}"],
      "env": { "NODE_ENV": "test" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
