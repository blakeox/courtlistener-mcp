{
  "name": "courtlistener-mcp-edge-test",
  "compatibility_date": "2026-03-02",
  "main": "src/worker-edge.ts",
  "workers_dev": true,
  "vars": {
    "MCP_OAUTH_BACKEND": "cloudflare",
    "MCP_ALLOW_DEV_FALLBACK": "false",
    "MCP_SESSION_LIFECYCLE_FAIL_OPEN": "false",
    "MCP_BOUNDARY_FAIL_OPEN": "false",
    "CODEMODE_ENABLED": "false",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000003",
    },
  ],
  "assets": {
    "directory": ".spa-dist",
    "binding": "SPA_ASSETS",
  },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
}
