{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courtlistener-mcp-mcp",
  "account_id": "cc3bb24ae3c87cff38c2be85df3dab29",
  "compatibility_date": "2026-08-18",
  "main": "src/worker-mcp.ts",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
    },
  },
  "vars": {
    "MCP_BOUNDARY_FAIL_OPEN": "false",
    "CODEMODE_ENABLED": "false",
    "MCP_ASYNC_QUEUE_ENABLED": "false",
    "MCP_CF_ANALYTICS_ENABLED": "true",
    "MCP_CF_STRUCTURED_LOGS_ENABLED": "true",
  },
  "ai": {
    "binding": "AI",
  },
  "kv_namespaces": [
    {
      "binding": "ASYNC_JOBS_KV",
      "id": "9903b38dea3d44399ed23ed4b0a51777",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "courtlistener_mcp",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASYNC_TOOL_QUEUE",
        "queue": "courtlistener-mcp-async-tool-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "courtlistener-mcp-async-tool-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "courtlistener-mcp-async-tool-jobs-dlq",
      },
    ],
  },
  "compatibility_flags": ["nodejs_als"],
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH_FAILURE_LIMITER",
        "class_name": "AuthFailureLimiterDO",
        "script_name": "courtlistener-mcp-auth-limiter",
      },
    ],
  },
}
