{
  "schema_version": "v1",
  "source_of_truth": {
    "worker_code_bindings_routes_compatibility": "wrangler",
    "durable_object_lifecycle": "wrangler",
    "worker_secrets": "wrangler",
    "account_zone_rules": "terraform_after_import",
    "observability_queries_and_alerts": "cloudflare_read_only_api"
  },
  "resources": [
    {
      "id": "worker.edge",
      "kind": "worker",
      "config": "wrangler.edge.jsonc",
      "owner": "wrangler",
      "change_policy": "versioned_release_controller"
    },
    {
      "id": "worker.mcp",
      "kind": "worker",
      "config": "wrangler.mcp.jsonc",
      "owner": "wrangler",
      "change_policy": "versioned_release_controller"
    },
    {
      "id": "worker.auth_limiter",
      "kind": "worker",
      "config": "wrangler.auth-limiter.jsonc",
      "owner": "wrangler",
      "change_policy": "versioned_release_controller"
    },
    {
      "id": "terraform.oauth_probe_skip",
      "kind": "zone_ruleset",
      "config": "infra/cloudflare/terraform/main.tf",
      "owner": "terraform",
      "change_policy": "import_first_no_destructive_plan",
      "state": "import_required_before_apply"
    },
    {
      "id": "observability.native_controls",
      "kind": "observability_contract",
      "config": "infra/cloudflare/observability-controls.json",
      "owner": "cloudflare_read_only_api",
      "change_policy": "reviewed_repository_contract_provider_activation_manual",
      "state": "provider_activation_pending"
    }
  ],
  "prohibited_terraform_kinds": [
    "cloudflare_worker",
    "cloudflare_workers_script",
    "cloudflare_workers_route",
    "cloudflare_workers_domain",
    "cloudflare_durable_object",
    "cloudflare_workers_kv_namespace",
    "cloudflare_queue",
    "cloudflare_pages_project"
  ]
}
