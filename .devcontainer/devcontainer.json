{
  "name": "Legal MCP Server Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",

  // Development ports
  "forwardPorts": [3001, 9229],
  "portsAttributes": {
    "3001": {
      "label": "MCP Server",
      "protocol": "http"
    },
    "9229": {
      "label": "Node Debug",
      "protocol": "http"
    }
  },

  // VS Code configuration
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "hbenl.vscode-test-explorer",
        "eamodio.gitlens",
        "humao.rest-client",
        "yzhang.markdown-all-in-one",
        "ms-vscode.dotenv"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "typescript.preferences.includePackageJsonAutoImports": "auto",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  // Post-creation commands
  "postCreateCommand": "corepack enable && corepack install && pnpm install --frozen-lockfile && pnpm run build",

  // Features
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Environment variables
  "remoteEnv": {
    "NODE_ENV": "development",
    "LOG_LEVEL": "debug"
  }
}
