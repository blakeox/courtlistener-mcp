{
  "name": "courtlistener-mcp",
  "version": "1.0.5",
  "description": "Legal research MCP server providing comprehensive access to CourtListener legal database",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "configs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "courtlistener-mcp": "dist/index.js"
  },
  "scripts": {
    "hooks:install": "node scripts/dev/install-git-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && node scripts/build/generate-package-version.mjs && pnpm run generate:web:spa && pnpm run generate:tool-schemas && pnpm run generate:hosted-auth-styles && tsc && pnpm run generate:manifest && pnpm run format:generated",
    "format:generated": "prettier --write manifest.json src/infrastructure/package-version.ts src/server/generated/tool-input-schemas.ts src/server/generated/tool-output-schemas.ts src/web/spa-build-id.ts src/server/hosted-auth-page-styles.generated.ts",
    "generate:web:spa": "node scripts/web/build-spa-assets.mjs",
    "generate:tool-schemas": "pnpm exec tsx scripts/build/generate-tool-schemas.mjs",
    "generate:hosted-auth-styles": "node scripts/build/embed-hosted-auth-styles.mjs",
    "generate:manifest": "pnpm exec tsx scripts/generate-manifest.ts",
    "dev:mcp": "wrangler dev -c wrangler.mcp.jsonc --port 3001",
    "dev:workers": "node scripts/dev/run-local-workers.mjs",
    "cloudflare:tail:edge": "wrangler tail -c wrangler.edge.jsonc",
    "cloudflare:tail:mcp": "wrangler tail -c wrangler.mcp.jsonc",
    "cloudflare:check": "node scripts/cloudflare/check-setup.js",
    "cloudflare:check:iac": "node scripts/cloudflare/check-iac-boundary.mjs",
    "cloudflare:check:startup": "node scripts/cloudflare/check-startup.mjs",
    "cloudflare:check:surface": "node scripts/cloudflare/check-worker-surface.mjs",
    "cloudflare:check:types": "node scripts/cloudflare/check-generated-types.mjs",
    "cloudflare:check:environments": "node scripts/cloudflare/check-environment-isolation.mjs",
    "cloudflare:check:live": "node scripts/cloudflare/check-live-inventory.mjs",
    "cloudflare:release:validate": "node scripts/cloudflare/validate-release-receipt.mjs",
    "cloudflare:release": "node scripts/cloudflare/release-controller.mjs",
    "cloudflare:release:probes": "node scripts/cloudflare/collect-release-probes.mjs",
    "cloudflare:secrets:sync-mcp": "node scripts/cloudflare/sync-mcp-secrets.mjs",
    "cloudflare:register:oauth": "node scripts/cloudflare/register-oauth-client.mjs",
    "cloudflare:waf:ensure": "node scripts/cloudflare/ensure-waf-probe-access.mjs",
    "cloudflare:zone:id": "node scripts/cloudflare/print-zone-id.mjs",
    "start": "node dist/index.js",
    "doctor": "node dist/index.js --doctor",
    "setup": "node dist/index.js --setup",
    "mcp": "node dist/index.js",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:spa:auth && pnpm run test:spa:e2e:auth",
    "test:all": "pnpm run test:unit && pnpm run test:integration && pnpm run test:spa:auth && pnpm run test:spa:e2e:auth",
    "test:unit": "pnpm exec tsx test/runners/run-unit-tests.ts",
    "test:spa": "node scripts/testing/run-spa-vitest.mjs",
    "test:spa:auth": "node scripts/testing/run-spa-auth-vitest.mjs",
    "test:spa:focus": "node scripts/testing/run-spa-vitest.mjs",
    "build:workers:test": "wrangler deploy --dry-run --outdir .tmp/workers-test/mcp -c wrangler.mcp.test.jsonc",
    "test:workers": "vitest run --config vitest.workers.config.ts && pnpm run build:workers:test && vitest run --config vitest.edge.workers.config.ts",
    "test:spa:e2e": "playwright test",
    "test:spa:design": "playwright test src/web-spa/e2e/design-smoke.spec.ts",
    "test:spa:design:lint": "node scripts/reports/check-design-system.mjs",
    "test:spa:a11y": "node scripts/testing/run-spa-vitest.mjs src/web-spa/src/__tests__/a11y-compliance.test.ts src/web-spa/src/__tests__/a11y-pages.test.tsx",
    "test:spa:a11y:smoke": "playwright test src/web-spa/e2e/a11y-smoke.spec.ts",
    "test:spa:a11y:lint": "node scripts/reports/check-a11y.mjs",
    "test:spa:e2e:auth": "node scripts/testing/run-spa-auth-playwright.mjs",
    "test:spa:e2e:headed": "playwright test --project=chromium --headed",
    "test:spa:e2e:debug": "playwright test --project=chromium --debug",
    "test:ts": "pnpm exec tsx test/unit/test-cache.ts",
    "test:integration": "pnpm exec tsx test/integration/test-api-integration.ts && pnpm run test:mcp:surface && pnpm run test:transport:http",
    "test:mcp:surface": "pnpm exec tsx --test --test-force-exit test/integration/test-mcp-surface-protocol.ts",
    "test:protocol": "pnpm run test:mcp:surface && pnpm run test:transport:http",
    "test:transport:http": "pnpm exec tsx --test --test-force-exit test/integration/test-http-v2.ts",
    "verify:shipped": "pnpm exec tsx scripts/testing/verify-shipped-release.mts",
    "test:performance": "node scripts/performance/load-profile-suite.js --light",
    "test:mcp": "pnpm exec tsx test/integration/test-mcp-protocol.ts",
    "test:mcp:remote": "node -e \"if (!process.env.SERVER_URL) { console.error('SERVER_URL is required for remote MCP tests'); process.exit(1); }\" && pnpm exec tsx test/integration/test-mcp-protocol.ts",
    "test:mcp:tool": "pnpm exec tsx test/integration/test-mcp-protocol.ts test-tool",
    "test:mcp:tariffs": "pnpm exec tsx --test test/integration/test-mcp-tariff-rulings.ts",
    "test:runtime-parity:certify": "pnpm exec tsx test/tools/runtime-parity-certification.ts",
    "test:infra:parity": "pnpm run test:mcp && pnpm exec tsx test/integration/test-quick-validation.ts && pnpm run test:runtime-parity:certify",
    "test:e2e:ai-chat-presets": "node scripts/testing/e2e-ai-chat-presets.mjs",
    "test:e2e:oauth-remote": "node scripts/testing/e2e-remote-oauth-handshake.mjs",
    "test:e2e:oauth-target": "node scripts/testing/validate-e2e-oauth-target.mjs",
    "test:e2e:oauth-approve-contract": "pnpm exec tsx scripts/testing/probe-production-approve-contract.ts",
    "test:e2e:worker-auth-flow": "node scripts/testing/e2e-remote-oauth-handshake.mjs",
    "dev": "tsc --watch --preserveWatchOutput",
    "dev:spa": "vite --config src/web-spa/vite.config.ts --host 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "lint:critical": "eslint src/worker-edge.ts src/worker-mcp.ts src/index.ts src/types.ts",
    "lint:src": "eslint src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \".devcontainer/devcontainer.json\" \".github/workflows/*.{yml,yaml}\" \"lefthook.yml\" \"package.json\" \"CONTRIBUTING.md\" \"eslint.config.js\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"vitest*.config.ts\" \"wrangler*.jsonc\"",
    "format:check": "prettier --check \".devcontainer/devcontainer.json\" \".github/workflows/*.{yml,yaml}\" \"lefthook.yml\" \"package.json\" \"CONTRIBUTING.md\" \"eslint.config.js\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"vitest*.config.ts\" \"wrangler*.jsonc\"",
    "clean": "node scripts/build/clean-dist.mjs",
    "health": "node scripts/dev/check-local-health.mjs",
    "ci:test:mcp-v2": "pnpm exec tsx test/runners/ci-test-mcp-v2.ts",
    "ci:test:mcp-v2:extended": "pnpm exec tsx test/runners/ci-test-mcp-v2.ts --extended",
    "ci:version-check": "node scripts/build/version-check.js",
    "ci:check:design-system": "node scripts/reports/check-design-system.mjs",
    "ci:analyze:worker-bundle": "node scripts/reports/analyze-worker-bundle.mjs",
    "ci:check:a11y": "node scripts/reports/check-a11y.mjs",
    "ci:check:repo-hygiene": "node scripts/reports/check-repo-hygiene.mjs",
    "ci:check:repo-hygiene:staged": "node scripts/reports/check-repo-hygiene.mjs --staged",
    "ci:check:generated": "node scripts/reports/check-generated-files-clean.mjs",
    "ci:local-gate": "node scripts/reports/local-gate.mjs",
    "ci:analyze-performance": "node scripts/performance/analyze-performance.js",
    "ci:compare-performance": "node scripts/performance/compare-performance.js",
    "ci:perf-gate": "node scripts/performance/ci-perf-gate.js",
    "ci:runtime-safety-gate": "node scripts/reports/runtime-safety-gate.js",
    "ci:release-readiness-gate": "node scripts/reports/release-readiness-gate.js",
    "ci:auth-release-gate": "node scripts/reports/auth-release-gate.js",
    "ci:api-parity-report": "pnpm exec tsx scripts/reports/api-parity-report.ts",
    "ci:load-profile-suite": "node scripts/performance/load-profile-suite.js",
    "ci:hardening:soak-leak-checks": "node scripts/performance/hardening-soak-and-leak-checks.js",
    "test:coverage": "pnpm exec tsx test/analysis/analyze-test-coverage.ts",
    "coverage": "c8 --config .c8rc.json pnpm run test:unit",
    "coverage:unit": "c8 --config .c8rc.json pnpm run test:unit",
    "coverage:check": "c8 --config .c8rc.json --check-coverage --branches=50 --functions=50 --lines=50 --statements=50 pnpm run test:unit",
    "test:analysis": "pnpm exec tsx test/analysis/analyze-untested-code.ts",
    "prepublishOnly": "pnpm run build && pnpm run typecheck",
    "prepare": "node scripts/dev/install-git-hooks.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "legal",
    "research",
    "courtlistener",
    "case-law",
    "legal-analysis"
  ],
  "author": "Legal MCP Contributors",
  "license": "MIT",
  "homepage": "https://github.com/blakeox/courtlistener-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/blakeox/courtlistener-mcp.git"
  },
  "packageManager": "pnpm@11.22.0+sha512.H/hwxMYTPf2I+yr8Rt0T1H8JyXlLQ4xv20fKmMrzvBY4HuC+k6CRuOOCTPAfiJ9G19niCRD7C+GrD7W6qA3WIQ==",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-query": "^5.101.4",
    "agents": "0.21.0",
    "jose": "^6.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "8.0.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.13.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sinon": "^22.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "wrangler": "4.124.0"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "pnpm exec eslint --fix --max-warnings=0 --no-warn-ignored",
      "pnpm exec prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "pnpm exec prettier --write"
    ]
  }
}
