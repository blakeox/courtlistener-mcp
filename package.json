{
  "name": "courtlistener-mcp",
  "version": "1.0.5",
  "description": "Legal research MCP server providing comprehensive access to CourtListener legal database",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "configs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "courtlistener-mcp": "dist/index.js"
  },
  "scripts": {
    "hooks:install": "node scripts/dev/install-git-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run generate:web:spa && tsc && npm run generate:manifest",
    "generate:web:spa": "node scripts/web/build-spa-assets.mjs",
    "generate:manifest": "npx tsx scripts/generate-manifest.ts",
    "deploy": "wrangler deploy",
    "cloudflare:check": "node scripts/cloudflare/check-setup.js",
    "cloudflare:deploy": "pnpm run cloudflare:check && wrangler deploy",
    "cloudflare:tail": "wrangler tail",
    "cloudflare:register:oauth": "node scripts/cloudflare/register-oauth-client.mjs",
    "cloudflare:waf:ensure": "node scripts/cloudflare/ensure-waf-probe-access.mjs",
    "cloudflare:zone:id": "node scripts/cloudflare/print-zone-id.mjs",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "doctor": "node dist/index.js --doctor",
    "setup": "node dist/index.js --setup",
    "mcp": "node dist/index.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:spa:auth && npm run test:spa:e2e:auth",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:spa:auth && npm run test:spa:e2e:auth",
    "test:unit": "npx tsx test/runners/run-unit-tests.ts",
    "test:spa": "node scripts/testing/run-spa-vitest.mjs",
    "test:spa:auth": "node scripts/testing/run-spa-auth-vitest.mjs",
    "test:spa:focus": "node scripts/testing/run-spa-vitest.mjs",
    "test:spa:e2e": "playwright test",
    "test:spa:design": "playwright test src/web-spa/e2e/design-smoke.spec.ts",
    "test:spa:design:lint": "node scripts/reports/check-design-system.mjs",
    "test:spa:a11y": "node scripts/testing/run-spa-vitest.mjs src/web-spa/src/__tests__/a11y-compliance.test.ts src/web-spa/src/__tests__/a11y-pages.test.tsx",
    "test:spa:a11y:smoke": "playwright test src/web-spa/e2e/a11y-smoke.spec.ts",
    "test:spa:a11y:lint": "node scripts/reports/check-a11y.mjs",
    "test:spa:e2e:auth": "node scripts/testing/run-spa-auth-playwright.mjs",
    "test:spa:e2e:headed": "playwright test --project=chromium --headed",
    "test:spa:e2e:debug": "playwright test --project=chromium --debug",
    "test:ts": "npx tsx test/unit/test-cache.ts",
    "test:integration": "npx tsx test/integration/test-api-integration.ts",
    "verify:shipped": "npx tsx scripts/testing/verify-shipped-release.mts",
    "test:performance": "echo 'Performance tests available in test/performance/'",
    "test:enterprise:full": "echo 'Enterprise tests available in test/enterprise/'",
    "test:enterprise:comprehensive": "echo 'Enterprise tests available in test/enterprise/'",
    "test:enterprise:middleware": "npm run test:enterprise:auth && npm run test:enterprise:sanitization && npm run test:enterprise:rate-limiting && npm run test:enterprise:audit && npm run test:enterprise:circuit-breaker",
    "test:enterprise:auth": "npx tsx test/middleware/test-authentication.ts",
    "test:enterprise:auth:comprehensive": "npx tsx test/middleware/test-auth-comprehensive.ts",
    "test:enterprise:sanitization": "npx tsx test/middleware/test-sanitization.ts",
    "test:enterprise:rate-limiting": "npx tsx test/middleware/test-rate-limiting.ts",
    "test:enterprise:rate-limiting:comprehensive": "npx tsx test/middleware/test-ratelimit-comprehensive.ts",
    "test:enterprise:audit": "npx tsx test/middleware/test-audit-logging.ts",
    "test:enterprise:audit:comprehensive": "npx tsx test/middleware/test-audit-comprehensive.ts",
    "test:enterprise:compression": "npx tsx test/middleware/test-compression.ts",
    "test:enterprise:circuit-breaker": "npx tsx test/middleware/test-circuit-breaker.ts",
    "test:enterprise:circuit-breaker:comprehensive": "echo 'Circuit breaker comprehensive tests available'",
    "test:enterprise:graceful-shutdown": "npx tsx test/middleware/test-graceful-shutdown.ts",
    "test:enterprise:integration": "npx tsx test/enterprise/integration/test-middleware-integration.ts",
    "test:enterprise:end-to-end": "npx tsx test/enterprise/integration/test-end-to-end.ts",
    "test:enterprise:performance": "echo 'Enterprise performance tests available'",
    "test:enterprise:performance:comprehensive": "echo 'Enterprise performance comprehensive tests available'",
    "test:enterprise:security:comprehensive": "npx tsx test/enterprise/security/test-security-reliability.ts",
    "test:enterprise:comprehensive:all": "echo 'Enterprise comprehensive tests available in test/enterprise/'",
    "test:enterprise:report": "echo 'Enterprise test report available in test/enterprise/'",
    "test:mcp": "npx tsx test/integration/test-mcp-protocol.ts",
    "test:mcp:remote": "node -e \"if (!process.env.SERVER_URL) { console.error('SERVER_URL is required for remote MCP tests'); process.exit(1); }\" && npx tsx test/integration/test-mcp-protocol.ts",
    "test:mcp:tool": "npx tsx test/integration/test-mcp-protocol.ts test-tool",
    "test:mcp:tariffs": "npx tsx --test test/integration/test-mcp-tariff-rulings.ts",
    "test:runtime-parity:certify": "npx tsx test/tools/runtime-parity-certification.ts",
    "test:infra:parity": "npm run test:mcp && npx tsx test/integration/test-quick-validation.ts && npm run test:runtime-parity:certify",
    "inspect": "node scripts/dev/inspect.js",
    "inspect:local": "node scripts/dev/inspect.js local",
    "inspect:remote": "node scripts/dev/inspect.js remote",
    "mcp:remote": "node scripts/dev/mcp-remote.js",
    "mcp:test:remote": "node scripts/dev/test-remote-mcp.js",
    "test:e2e:ai-chat-presets": "node scripts/testing/e2e-ai-chat-presets.mjs",
    "test:e2e:oauth-remote": "node scripts/testing/e2e-remote-oauth-handshake.mjs",
    "test:e2e:oauth-target": "node scripts/testing/validate-e2e-oauth-target.mjs",
    "test:e2e:oauth-approve-contract": "npx tsx scripts/testing/probe-production-approve-contract.ts",
    "test:e2e:worker-auth-flow": "node scripts/testing/e2e-remote-oauth-handshake.mjs",
    "dev": "tsc --watch --preserveWatchOutput",
    "dev:spa": "vite --config src/web-spa/vite.config.ts --host 127.0.0.1 --port 5173",
    "lint": "eslint .",
    "lint:critical": "eslint src/worker.ts src/index.ts src/types.ts",
    "lint:src": "eslint src",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \".github/workflows/*.{yml,yaml}\" \"lefthook.yml\" \"package.json\" \"CONTRIBUTING.md\" \"eslint.config.js\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"wrangler.jsonc\"",
    "format:check": "prettier --check \".github/workflows/*.{yml,yaml}\" \"lefthook.yml\" \"package.json\" \"CONTRIBUTING.md\" \"eslint.config.js\" \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"wrangler.jsonc\"",
    "clean": "node scripts/build/clean-dist.mjs",
    "health": "curl -f http://localhost:3001/health || exit 1",
    "enterprise:setup": "./scripts/build/setup-enterprise.sh",
    "enterprise:demo": "npx tsx enterprise-demo.ts",
    "enterprise:benchmark": "node scripts/performance/benchmark-enterprise.js",
    "demo:documentation": "npx tsx api-documentation-demo.ts",
    "docs:serve": "npx tsx api-documentation-demo.ts",
    "docker:enterprise": "docker build -f Dockerfile.enterprise -t legal-mcp:enterprise .",
    "ci:test-inspector": "npx tsx test/runners/ci-test-mcp-inspector.ts",
    "ci:test-inspector:extended": "npx tsx test/runners/ci-test-mcp-inspector.ts --extended",
    "ci:test-inspector:enhanced": "npx tsx test/runners/enhanced-ci-test-inspector.ts",
    "ci:test-inspector:enhanced:extended": "npx tsx test/runners/enhanced-ci-test-inspector.ts --extended",
    "ci:test-inspector:performance": "ENABLE_PERFORMANCE_TESTS=true npx tsx test/runners/enhanced-ci-test-inspector.ts",
    "ci:version-check": "node scripts/build/version-check.js",
    "ci:check:design-system": "node scripts/reports/check-design-system.mjs",
    "ci:check:a11y": "node scripts/reports/check-a11y.mjs",
    "ci:check:repo-hygiene": "node scripts/reports/check-repo-hygiene.mjs",
    "ci:check:repo-hygiene:staged": "node scripts/reports/check-repo-hygiene.mjs --staged",
    "ci:check:generated": "node scripts/reports/check-generated-files-clean.mjs",
    "ci:local-gate": "node scripts/reports/local-gate.mjs",
    "ci:analyze-performance": "node scripts/performance/analyze-performance.js",
    "ci:compare-performance": "node scripts/performance/compare-performance.js",
    "ci:perf-gate": "node scripts/performance/ci-perf-gate.js",
    "ci:runtime-safety-gate": "node scripts/reports/runtime-safety-gate.js",
    "ci:release-readiness-gate": "node scripts/reports/release-readiness-gate.js",
    "ci:auth-release-gate": "node scripts/reports/auth-release-gate.js",
    "ci:api-parity-report": "npx tsx scripts/reports/api-parity-report.ts",
    "ci:load-profile-suite": "node scripts/performance/load-profile-suite.js",
    "ci:hardening:soak-leak-checks": "node scripts/performance/hardening-soak-and-leak-checks.js",
    "test:coverage": "npx tsx test/analysis/analyze-test-coverage.ts",
    "coverage": "c8 --config .c8rc.json npm run test:unit",
    "coverage:unit": "c8 --config .c8rc.json npm run test:unit",
    "coverage:check": "c8 --config .c8rc.json --check-coverage --branches=50 --functions=50 --lines=50 --statements=50 npm run test:unit",
    "test:analysis": "npx tsx test/analysis/analyze-untested-code.ts",
    "prepublishOnly": "npm run build && npm run typecheck",
    "prepare": "node scripts/dev/install-git-hooks.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "legal",
    "research",
    "courtlistener",
    "case-law",
    "legal-analysis"
  ],
  "author": "Legal MCP Contributors",
  "license": "MIT",
  "homepage": "https://github.com/blakeox/courtlistener-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/blakeox/courtlistener-mcp.git"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@tanstack/react-query": "^5.100.14",
    "agents": "^0.13.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "node-fetch": "^3.3.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/workers-types": "^4.20260525.1",
    "@modelcontextprotocol/inspector": "^0.21.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.5.2",
    "axe-core": "^4.11.4",
    "c8": "^10.1.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^28.1.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.7",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "sinon": "^21.0.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0",
    "wrangler": "^4.94.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "@eslint/eslintrc>ajv": "6.14.0",
      "eslint>ajv": "6.14.0",
      "@protobufjs/utf8@<=1.1.0": ">=1.1.1",
      "ajv@<6.14.0": ">=6.14.0",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "protobufjs@<7.5.5": ">=7.5.5",
      "protobufjs@<=7.5.5": ">=7.5.6",
      "protobufjs@<=7.5.7": ">=7.5.8",
      "qs@<6.14.1": ">=6.14.1",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "undici@>=7.17.0 <7.24.0": ">=7.24.0",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "pnpm exec eslint --fix --max-warnings=0 --no-warn-ignored",
      "pnpm exec prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "pnpm exec prettier --write"
    ]
  }
}
