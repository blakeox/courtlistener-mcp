{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "courtlistener-mcp-staging-mcp",
  "compatibility_date": "2026-03-02",
  "main": "src/worker-mcp.ts",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "MCP_OAUTH_BACKEND": "cloudflare",
    "MCP_ALLOW_DEV_FALLBACK": "false",
    "MCP_SESSION_IDLE_TTL_SECONDS": "900",
    "MCP_SESSION_LIFECYCLE_FAIL_OPEN": "false",
    "MCP_BOUNDARY_FAIL_OPEN": "false",
    "CODEMODE_ENABLED": "false",
    "MCP_ASYNC_QUEUE_ENABLED": "false",
    "MCP_CF_STRUCTURED_LOGS_ENABLED": "true",
  },
  "ai": {
    "binding": "AI",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5d6b587f16d74ac6ae5ad78d5765d5f4",
    },
    {
      "binding": "ASYNC_JOBS_KV",
      "id": "b41d2686110546e88989c375e4bc10fb",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "courtlistener_mcp_staging",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASYNC_TOOL_QUEUE",
        "queue": "courtlistener-mcp-staging-async-tool-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "courtlistener-mcp-staging-async-tool-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "courtlistener-mcp-staging-async-tool-jobs-dlq",
      },
    ],
  },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "CourtListenerMCP",
      },
      {
        "name": "AUTH_FAILURE_LIMITER",
        "class_name": "AuthFailureLimiterDO",
        "script_name": "courtlistener-mcp-staging-auth-limiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CourtListenerMCP"],
    },
  ],
}
